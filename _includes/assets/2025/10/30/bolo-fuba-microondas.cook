---
title: "Bolinho De Fubá De Micro-Ondas"
servings: 1
time: 5m
time.prep: 2m
time.cook: 2m
course: "snack"
cuisine: "Brazilian"
source: https://www.receiteria.com.br/receita/bolinho-de-fuba-de-micro-ondas/
---

@fubá mimoso {2%tbsp}
@açúcar de coco {1%tbsp}
@ovo {1 unidade}
@óleo de coco {1%tbsp}
@suco de laranja {1 unidade}
@sal {1%pitada}
@fermento em pó {0.5%tsp =}
@maçã fatiada {0.5 unidade}

# tigela
-- Em uma tigela, misture todos os ingredientes, menos as fatias de maçã e o fermento --
@fubá mimoso {2%tbsp}
@açúcar de coco {1%tbsp}
@ovo {1 unidade}
@óleo de coco {1%tbsp}
@suco de laranja {1 unidade}
@sal {1%pitada}

# tigela
-- Incorpore o fermento rapidamente --
@fermento em pó {0.5%tsp =}

# xícara
-- Acomode as fatias de maçã em uma xícara e despeje a massa --
@maçã fatiada {0.5 unidade}

~ timer 2m -- Asse no micro-ondas por 2 minutos

-- Está pronto! Aproveite --

[] Lista de Compras
@fubá mimoso {2%tbsp}
@açúcar de coco {1%tbsp}
@ovo {1 unidade}
@óleo de coco {1%tbsp}
@suco de laranja {1 unidade}
@sal {1%pitada}
@fermento em pó {0.5%tsp}
@maçã fatiada {0.5 unidade}

[pantry]
fubá mimoso = 100%g
açúcar de coco = 50%g
óleo de coco = 100%ml
maçã = 1 unidade
